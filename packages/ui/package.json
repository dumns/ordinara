{
  "name": "@ordinara/ui",
  "version": "0.1.0",
  "description": "Ordinara UI components",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./src/fonts.css",
    "./library/*": {
      "source": "./src/library/pages/*.ts",
      "types": "./dist/library/pages/*.d.ts",
      "import": "./dist/library/pages/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:library": "node scripts/gen-library.mjs && node scripts/gen-library-safelist.mjs",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../scripts/copy-changelog.mjs",
    "postpack": "node ../../scripts/copy-changelog.mjs --clean"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@ordinara/icons": "0.1.0",
    "@ordinara/tokens": "0.1.0",
    "apexcharts": "^4.7.0",
    "flowbite": "^4.0.2",
    "simple-datatables": "^10.3.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "lucide-static": "^1.57.0",
    "tsup": "^9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dumns/ordinara.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/dumns/ordinara#readme",
  "bugs": {
    "url": "https://github.com/dumns/ordinara/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
