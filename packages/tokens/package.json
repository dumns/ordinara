{
  "name": "@ordinara/tokens",
  "version": "0.1.0",
  "description": "Ordinara design tokens (Tailwind CSS v4 theme + CSS variables)",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dumns/ordinara.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/dumns/ordinara#readme",
  "bugs": {
    "url": "https://github.com/dumns/ordinara/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "node ../../scripts/copy-changelog.mjs",
    "postpack": "node ../../scripts/copy-changelog.mjs --clean"
  }
}
